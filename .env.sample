# YouTutorAI environment variables.
# Copy to `.env` for local dev or `.env.production` for prod. All vars prefixed with YTAI_.

YTAI_DATABASE_URL=postgres://localhost:5432/yoututorai
YTAI_API_PORT=9521
YTAI_PORTAL_PORT=9522
YTAI_PUBLIC_URL=http://localhost:9522

YTAI_JWT_SECRET=

# Google Sign-In (Google Identity Services). Create an OAuth 2.0 Client ID of
# type "Web application" in the Google Cloud Console, add http://localhost:9522
# (and your prod origin) to "Authorized JavaScript origins", and paste the
# Client ID below. Leave unset to disable Google SSO — /api/auth/google returns
# 503 and the homepage button greys out.
YTAI_GOOGLE_CLIENT_ID=141448668439-jj21t4ctgr5lgetk7mpkc6ggdthmmvp7.apps.googleusercontent.com

YTAI_OPENROUTER_API_KEY=
# OpenRouter model ids are <provider>/<model>. Examples:
#   deepseek/deepseek-v4-flash, anthropic/claude-sonnet-4-6,
#   openai/gpt-4o, google/gemini-2.5-pro, qwen/qwen2.5-vl-7b-instruct
YTAI_OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash
YTAI_OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-7b-instruct
# Override the chat-completions base URL. Defaults to https://openrouter.ai/api/v1.
YTAI_OPENROUTER_BASE_URL=
# Per-route override for vision. Used in local dev to point at LM Studio:
#   YTAI_VISION_BASE_URL=http://localhost:9529/v1
#   YTAI_VISION_API_KEY=lm-studio
#   YTAI_OPENROUTER_VISION_MODEL=qwen-vl   (LM Studio identifier set by `pnpm start:local:vl`)
# When unset, vision uses YTAI_OPENROUTER_BASE_URL / YTAI_OPENROUTER_API_KEY.
YTAI_VISION_BASE_URL=
YTAI_VISION_API_KEY=

# S3 bucket for session images and TTS audio. When unset, persistImage /
# persistAudio fall back to local disk under YTAI_IMAGE_DIR / YTAI_AUDIO_DIR.
# In prod (set by CDK) this is the bucket the stack provisions; for local
# dev, point at the same bucket and let YTAI_S3_PREFIX namespace your keys.
YTAI_S3_BUCKET=
# Key namespace inside the bucket. Defaults to "dev" so a misconfigured
# laptop can't write into prod's keyspace. CDK sets this to the deployed
# stage ("prod") in production.
YTAI_S3_PREFIX=prod
YTAI_IMAGE_RETENTION_DAYS=30

# AWS SES (sign-in OTP email delivery). The "from" address must be a verified
# SES identity (or the entire sending domain must be verified) in the chosen
# region. While in the SES sandbox, the recipient address must also be
# verified. Leave YTAI_SES_FROM_EMAIL unset to skip SES — the OTP is still
# stored in the DB and logged, so an operator can read the code from server
# logs.
YTAI_SES_FROM_EMAIL=
# AWS region for both SES and S3. Defaults to ap-southeast-2 if unset.
YTAI_AWS_REGION=ap-southeast-2
# AWS credentials follow the standard SDK chain (env vars, ~/.aws/credentials,
# or IAM role on EC2/ECS/Lambda). For local dev, uncomment and set these or
# run `aws configure` to use a named profile via AWS_PROFILE:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# TTS (Eyes' voice cousin). Frontend POSTs sentences to /api/tutor/:sessionId/speak;
# the server proxies to an OpenAI-compatible /audio/speech endpoint. For local dev
# we run Kokoro-FastAPI via `pnpm start:local:tts`:
#   YTAI_TTS_BASE_URL=http://localhost:9530/v1
# Leave unset to disable voice — the /speak route returns 503 and the UI greys
# out the voice toggle.
YTAI_TTS_BASE_URL=
YTAI_TTS_API_KEY=
YTAI_TTS_MODEL=kokoro
# Kokoro voice ids: af_heart (warm female), af_bella, af_sky, am_adam, am_michael, …
YTAI_TTS_VOICE=af_heart
# Where to cache MP3 bytes on disk (mirrors YTAI_IMAGE_DIR).
YTAI_AUDIO_DIR=./data/audio

# OCR (PaddleOCR sidecar). Provides tight text bboxes via find_text_on_image,
# so Brain can point at printed worksheet text without burning a vision call.
# For local dev, run `pnpm start:local:ocr` and set:
#   YTAI_OCR_BASE_URL=http://localhost:9531
# Leave unset to disable OCR — Brain falls back to lookup_on_image for everything.
YTAI_OCR_BASE_URL=
YTAI_OCR_API_KEY=
