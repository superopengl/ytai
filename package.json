{
  "name": "@techseeding/yoututorai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "concurrently -n api,portal -c blue,magenta \"pnpm dev:api\" \"pnpm dev:portal\"",
    "start:api": "node --watch --env-file=.env src/api/server.js",
    "start:portal": "pnpm -F @techseeding/yoututorai-portal dev",
    "start:local:vl": "lms server start --port 9529 && (lms unload qwen-vl 2>/dev/null || true) && lms load qwen/qwen2.5-vl-7b --context-length 32768 --gpu max --identifier qwen-vl",
    "build:prod": "pnpm -F @techseeding/yoututorai-portal build && mkdir -p dist/src && cp -R src/api dist/src/api",
    "start:prod": "node --env-file=.env.production dist/src/api/server.js",
    "build:docker": "docker build -f devops/Dockerfile -t yoututorai .",
    "db:generate": "drizzle-kit generate --config=src/api/drizzle.config.js",
    "db:migrate": "node --env-file=.env src/api/db/migrate.js",
    "db:studio": "drizzle-kit studio --config=src/api/drizzle.config.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.28.0"
  }
}
