{
  "name": "@techseeding/yoututorai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "concurrently -n api,portal -c blue,magenta \"pnpm start:api\" \"pnpm start:portal\"",
    "start:api": "NODE_ENV=development node --watch --env-file=.env src/api/server.js",
    "start:portal": "pnpm -F @techseeding/yoututorai-portal dev",
    "start:local:vl": "lms server start --port 9529 && (lms unload qwen-vl 2>/dev/null || true) && lms load qwen/qwen2.5-vl-7b --context-length 32768 --gpu max --identifier qwen-vl",
    "start:local:tts": "docker compose -f docker-compose.dev.yml up tts",
    "stop:local:tts": "docker compose -f docker-compose.dev.yml down",
    "start:local:ocr": "docker compose -f docker-compose.dev.yml up ocr",
    "stop:local:ocr": "docker compose -f docker-compose.dev.yml down",
    "build:prod": "rm -rf dist && pnpm -F @techseeding/yoututorai-portal build && mkdir -p dist/src && cp -R src/api dist/src/api && cp package.json pnpm-lock.yaml dist/ && printf 'only-built-dependencies[]=sharp\\nonly-built-dependencies[]=esbuild\\n' > dist/.npmrc",
    "start:prod": "NODE_ENV=production node --env-file=.env.production dist/src/api/server.js",
    "build:docker": "docker build -f devops/Dockerfile -t yoututorai .",
    "release": "git push && ./scripts/release.sh",
    "db:generate": "drizzle-kit generate --config=src/api/drizzle.config.js",
    "db:migrate": "node --env-file=.env src/api/db/migrate.js",
    "db:studio": "drizzle-kit studio --config=src/api/drizzle.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "jsonrepair": "^3.14.0",
    "pino-pretty": "^11.2.2",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.28.0"
  }
}
